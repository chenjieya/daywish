{
  "name": "daywish",
  "productName": "好日将至",
  "version": "0.2.2",
  "private": true,
  "description": "把值得期待的日子，放在桌面上。",
  "author": "jie.chen",
  "type": "module",
  "main": "dist-electron/desktop/main.js",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "postinstall": "node scripts/prepare-electron.cjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "site:dev": "node scripts/prepare-site.mjs && vite --config website/vite.config.ts",
    "site:check": "vue-tsc --noEmit -p tsconfig.website.json",
    "site:build": "node scripts/prepare-site.mjs && pnpm site:check && vite build --config website/vite.config.ts",
    "ts:check": "vue-tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "build": "pnpm ts:check && vite build && tsc -p tsconfig.desktop.json",
    "test": "node scripts/sync-mac-data.mjs --check && node --experimental-strip-types --test tests/*.test.ts",
    "start": "electron .",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "pnpm build && electron-builder --win --dir --x64 --publish never"
  },
  "dependencies": { "vue": "^3.5.46" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": { "onlyBuiltDependencies": ["electron", "esbuild"] },
  "build": {
    "appId": "com.daywish.desktop",
    "productName": "好日将至",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": { "target": "nsis", "artifactName": "Daywish-${version}-Windows-${arch}-Setup.${ext}", "icon": "public/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "好日将至" }
  }
}
