{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "rootDir": ".", "outDir": "dist-electron",
    "types": ["node"], "resolveJsonModule": true, "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts", "src/types/settings.ts"]
}
